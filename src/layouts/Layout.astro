---
interface Props {
  title?: string;
}
const { title = "Jay-Mar J. Lemon — Web Developer" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Jay-Mar J. Lemon, web developer with experience in HTML, CSS, JavaScript, PHP, WordPress, and modern tools like Astro and TypeScript." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      // Apply saved theme before paint to avoid a flash of the wrong theme
      const saved = localStorage.getItem("theme");
      if (saved === "dark" || (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="#top" class="nav-brand">JM Lemon</a>
        <div class="nav-links">
          <a href="#about">About</a>
          <a href="#skills">Skills</a>
          <a href="#experience">Experience</a>
          <a href="#projects">Projects</a>
          <a href="#contact">Contact</a>
        </div>
        <button id="theme-toggle" aria-label="Toggle dark mode" class="theme-toggle">
          <span class="icon-sun">☀</span>
          <span class="icon-moon">☾</span>
        </button>
      </nav>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Jay-Mar J. Lemon. Built with Astro.</p>
    </footer>

    <script is:inline>
      const btn = document.getElementById("theme-toggle");
      btn.addEventListener("click", () => {
        const isDark = document.documentElement.getAttribute("data-theme") === "dark";
        if (isDark) {
          document.documentElement.removeAttribute("data-theme");
          localStorage.setItem("theme", "light");
        } else {
          document.documentElement.setAttribute("data-theme", "dark");
          localStorage.setItem("theme", "dark");
        }
      });
    </script>

    <style is:global>
      :root {
        --bg: #FAFAF9;
        --bg-subtle: #F1F0EE;
        --ink: #1A1D1F;
        --ink-muted: #5B6164;
        --accent: #2F6F5E;
        --accent-soft: #E4EEEB;
        --border: #E1DFDA;
        --font-heading: "Space Grotesk", sans-serif;
        --font-body: "IBM Plex Sans", sans-serif;
      }

      :root[data-theme="dark"] {
        --bg: #12181B;
        --bg-subtle: #1A2226;
        --ink: #EDEEF0;
        --ink-muted: #9BA3A7;
        --accent: #4FA98A;
        --accent-soft: #1E2E29;
        --border: #26302F;
      }

      * { box-sizing: border-box; }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 5rem;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-body);
        line-height: 1.6;
        transition: background 0.2s ease, color 0.2s ease;
      }

      h1, h2, h3 {
        font-family: var(--font-heading);
        line-height: 1.15;
        margin: 0 0 0.5em;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      section {
        max-width: 720px;
        margin: 0 auto;
        padding: 5rem 1.5rem;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }

      .nav {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
      }

      .nav-brand {
        font-family: var(--font-heading);
        font-weight: 600;
        color: var(--ink);
        font-size: 1.05rem;
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
      }

      .nav-links a {
        color: var(--ink-muted);
        font-size: 0.95rem;
      }

      .nav-links a:hover {
        color: var(--accent);
      }

      .theme-toggle {
        background: none;
        border: 1px solid var(--border);
        border-radius: 6px;
        width: 2.1rem;
        height: 2.1rem;
        cursor: pointer;
        color: var(--ink);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .icon-moon { display: none; }
      :root[data-theme="dark"] .icon-sun { display: none; }
      :root[data-theme="dark"] .icon-moon { display: inline; }

      .site-footer {
        text-align: center;
        padding: 2.5rem 1.5rem;
        color: var(--ink-muted);
        font-size: 0.85rem;
        border-top: 1px solid var(--border);
      }

      @media (max-width: 640px) {
        .nav-links { gap: 1rem; }
        .nav-links a { font-size: 0.85rem; }
        section { padding: 3.5rem 1.25rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        * { transition: none !important; }
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
    </style>
  </body>
</html>

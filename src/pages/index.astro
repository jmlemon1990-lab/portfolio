---
import Layout from "../layouts/Layout.astro";

const skills = [
  "HTML & CSS",
  "JavaScript",
  "PHP",
  "WordPress",
  "TypeScript",
  "Astro",
  "Git & GitHub",
  "React (learning)",
  "Tailwind CSS (learning)",
];

const experience = [
  {
    role: "IT Site-Support Personnel",
    org: "Government Office",
    period: "2019 — 2026",
    description:
      "Provided on-site technical support, maintained hardware and network systems, and troubleshot day-to-day IT issues for staff and equipment.",
  },
  {
    role: "Web Developer",
    org: "Freelance / Contract",
    period: "2017 — 2019",
    description:
      "Built and maintained websites using HTML, CSS, JavaScript, and PHP, with several projects delivered on WordPress for small business clients.",
  },
];

const projects = [
  {
    title: "Project coming soon",
    description: "A new build is in progress — check back shortly.",
  },
  {
    title: "Project coming soon",
    description: "A new build is in progress — check back shortly.",
  },
  {
    title: "Project coming soon",
    description: "A new build is in progress — check back shortly.",
  },
];
---
<Layout>
  <section class="hero">
    <p class="eyebrow">Web Developer</p>
    <h1>Jay-Mar J. Lemon</h1>
    <p class="hero-lede">
      BS Information Technology graduate returning to web development after
      several years in IT support — picking up React and Tailwind CSS while
      building on a foundation in HTML, CSS, JavaScript, PHP, and WordPress.
    </p>
    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary">View projects</a>
      <a href="/resume.pdf" class="btn btn-outline" download>Download resume</a>
    </div>
  </section>

  <section id="about">
    <h2>About</h2>
    <p>
      I started my career as a web developer in 2017, building sites with
      HTML, CSS, JavaScript, PHP, and WordPress. In 2019 I moved into IT
      site-support at a government office, where I spent several years
      maintaining systems and solving hands-on technical problems for staff.
    </p>
    <p>
      I'm now returning to web development, rebuilding my skills with modern
      tools like Astro and TypeScript, and currently learning React and
      Tailwind CSS. I hold a BS in Information Technology and bring a mix of
      practical development experience and real-world IT troubleshooting to
      every project.
    </p>
  </section>

  <section id="skills">
    <h2>Skills</h2>
    <ul class="skills-grid">
      {skills.map((skill) => (
        <li>{skill}</li>
      ))}
    </ul>
  </section>

  <section id="experience">
    <h2>Experience</h2>
    <div class="timeline">
      {experience.map((job) => (
        <div class="timeline-item">
          <p class="timeline-period">{job.period}</p>
          <h3>{job.role}</h3>
          <p class="timeline-org">{job.org}</p>
          <p>{job.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="projects">
    <h2>Projects</h2>
    <div class="project-grid">
      {projects.map((project) => (
        <div class="project-card">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <p>Open to web development roles, freelance work, or a conversation.</p>
    <ul class="contact-list">
      <li><a href="mailto:jm.lemon1990@gmail.com">jm.lemon1990@gmail.com</a></li>
      <li><a href="https://github.com/jmlemon1990-lab" target="_blank" rel="noopener">github.com/jmlemon1990-lab</a></li>
    </ul>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 6rem;
    padding-bottom: 4rem;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 0.75rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .hero-lede {
    color: var(--ink-muted);
    font-size: 1.05rem;
    max-width: 34rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
  }

  .btn-outline {
    border: 1px solid var(--border);
    color: var(--ink);
  }

  .skills-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skills-grid li {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.45rem 0.9rem;
    font-size: 0.9rem;
  }

  .timeline-item {
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  .timeline-item:first-child {
    border-top: none;
  }

  .timeline-period {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 500;
    margin: 0 0 0.25rem;
  }

  .timeline-org {
    color: var(--ink-muted);
    margin-top: -0.4rem;
  }

  .project-grid {
    display: grid;
    gap: 1rem;
  }

  .project-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    background: var(--bg-subtle);
  }

  .project-card h3 {
    margin-bottom: 0.4rem;
  }

  .project-card p {
    color: var(--ink-muted);
    margin: 0;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>